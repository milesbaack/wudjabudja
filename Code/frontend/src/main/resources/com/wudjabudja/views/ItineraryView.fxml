<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Itinerary (MVP-09 & FINAL-01): AI options by day and time block with local filtering, sorting, and consensus mode. -->
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.ItineraryController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER" styleClass="app-canvas">
            <VBox spacing="20.0" maxWidth="1160.0" styleClass="page-container">

                <!-- Trip Header & Actions Card -->
                <VBox spacing="14.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="ITINERARY" styleClass="badge, badge-teal" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="generatedLabel" text="" styleClass="subtle-text" />
                    </HBox>

                    <VBox spacing="4.0">
                        <Label fx:id="tripTitleLabel" text="Your trip" styleClass="page-title" wrapText="true" />
                        <Label fx:id="tripDetailsLabel" text="" styleClass="body-text" wrapText="true" />
                    </VBox>

                    <FlowPane hgap="10.0" vgap="10.0" alignment="CENTER_LEFT">
                        <Button fx:id="generateBtn" text="Generate Itinerary" onAction="#handleGenerate"
                                styleClass="btn-primary" />
                        <Button text="Vote on Options" onAction="#goToVoting" styleClass="btn-accent" />
                        <Button text="Travelers &amp; Quizzes" onAction="#goToSharedTrip" styleClass="btn-secondary" />
                        <Button fx:id="editPrefsBtn" text="Edit Preferences" onAction="#goToPreferences"
                                styleClass="btn-secondary" />
                    </FlowPane>

                    <!-- Busy Spinner -->
                    <HBox fx:id="busyBox" alignment="CENTER_LEFT" spacing="12.0"
                          visible="false" managed="false" styleClass="banner-busy">
                        <ProgressIndicator prefWidth="20.0" prefHeight="20.0" />
                        <Label fx:id="busyLabel" text="" styleClass="banner-busy-text" wrapText="true" />
                    </HBox>

                    <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="Infinity"
                           visible="false" managed="false" />
                </VBox>

                <!-- Final Consensus Budget Summary Banner (visible once votes elect winners) -->
                <HBox fx:id="consensusBudgetCard" alignment="CENTER_LEFT" spacing="16.0"
                      visible="false" managed="false" styleClass="banner-consensus">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="consensusTitleLabel" text="Consensus &quot;Perfect Days&quot; Elected"
                               style="-fx-text-fill: #92400E; -fx-font-weight: bold; -fx-font-size: 15px;" />
                        <Label fx:id="consensusCostLabel" text=""
                               style="-fx-text-fill: #78350F; -fx-font-size: 12.5px;" wrapText="true" />
                    </VBox>
                    <Label fx:id="consensusBudgetBadge" text="Within Trip Budget" styleClass="badge, badge-success" />
                </HBox>

                <!-- Local Filter & Sort Controls Bar (Responsive FlowPane) -->
                <VBox fx:id="filterBarCard" spacing="12.0" visible="false" managed="false" styleClass="card-compact">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <HBox spacing="4.0" styleClass="segment-container">
                            <Button fx:id="allOptionsModeBtn" text="All 3 Options per Block"
                                    onAction="#handleShowAllOptions" styleClass="segment-btn-active" />
                            <Button fx:id="winnersOnlyModeBtn" text="Winning Consensus Only"
                                    onAction="#handleShowWinnersOnly" styleClass="segment-btn" />
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="filterSummaryLabel" text="" styleClass="meta-text" />
                    </HBox>

                    <Region styleClass="divider" />

                    <FlowPane hgap="12.0" vgap="10.0" alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label text="Category" styleClass="field-label" />
                            <ComboBox fx:id="categoryFilterCombo" onAction="#handleFilterOrSortChanged"
                                      prefWidth="150.0" styleClass="combo-sm" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label text="Traveler" styleClass="field-label" />
                            <ComboBox fx:id="travelerFilterCombo" onAction="#handleFilterOrSortChanged"
                                      prefWidth="185.0" styleClass="combo-sm" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label text="Sort by" styleClass="field-label" />
                            <ComboBox fx:id="sortCombo" onAction="#handleFilterOrSortChanged"
                                      prefWidth="170.0" styleClass="combo-sm" />
                        </HBox>

                        <Button text="Reset Filters" onAction="#handleResetFilters" styleClass="btn-secondary, btn-sm" />
                    </FlowPane>
                </VBox>

                <!-- Empty State -->
                <VBox fx:id="emptyStateBox" spacing="10.0" alignment="CENTER"
                      visible="false" managed="false" styleClass="empty-state">
                    <Label text="No itinerary generated yet" styleClass="section-title" />
                    <Label text="Click &quot;Generate Itinerary&quot; to create 3 curated options for every morning, afternoon, and evening of your trip based on your group's quiz answers."
                           styleClass="body-text" wrapText="true" maxWidth="540.0"
                           style="-fx-text-alignment: center;" />
                </VBox>

                <!-- Day Cards -->
                <VBox fx:id="daysBox" spacing="20.0" />

            </VBox>
        </StackPane>
    </content>
</ScrollPane>
