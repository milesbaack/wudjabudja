<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Trip Setup: Destination, dates, trip type and budget -> POST /api/trips -> preferences quiz. -->
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.TripSetupController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER" styleClass="app-canvas">
            <VBox spacing="22.0" maxWidth="960.0" styleClass="page-container">

                <!-- Page Header -->
                <VBox spacing="6.0">
                    <Label text="PLAN A TRIP" styleClass="badge, badge-teal" />
                    <Label text="Where are you headed?" styleClass="page-title" />
                    <Label text="Set up the essentials below, then complete the quick preferences quiz to generate tailored daily options."
                           styleClass="body-text" wrapText="true" />
                </VBox>

                <!-- Active Trip Quick-Resume Banner -->
                <HBox fx:id="currentTripBox" alignment="CENTER_LEFT" spacing="12.0"
                      visible="false" managed="false" styleClass="banner-info">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="CURRENTLY OPEN TRIP" styleClass="badge, badge-teal" />
                        <Label fx:id="currentTripLabel" text="" styleClass="item-title" wrapText="true" />
                    </VBox>
                    <Button text="Travelers" onAction="#goToSharedTrip" styleClass="btn-secondary, btn-sm" />
                    <Button text="Quiz" onAction="#goToQuiz" styleClass="btn-soft, btn-sm" />
                    <Button text="Itinerary" onAction="#goToItinerary" styleClass="btn-primary, btn-sm" />
                </HBox>

                <!-- Trip Creation Form Card -->
                <VBox spacing="20.0" styleClass="card">
                    <VBox spacing="3.0">
                        <Label text="New Trip Details" styleClass="section-title" />
                        <Label text="Trips can span 1 to 7 days. You can invite additional travelers right after creation."
                               styleClass="meta-text" wrapText="true" />
                    </VBox>

                    <!-- Row 1: Destination + Trip Type -->
                    <HBox spacing="18.0" alignment="TOP_LEFT">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Destination" styleClass="field-label" />
                            <TextField fx:id="destinationField" promptText="e.g. San Diego, Tokyo, Austin" />
                            <Label fx:id="destinationError" styleClass="field-error"
                                   managed="false" visible="false" wrapText="true" />
                        </VBox>

                        <VBox spacing="6.0" prefWidth="250.0" minWidth="210.0">
                            <Label text="Trip Type" styleClass="field-label" />
                            <ComboBox fx:id="tripTypeCombo" promptText="Select trip vibe" maxWidth="Infinity" />
                            <Label fx:id="tripTypeError" styleClass="field-error"
                                   managed="false" visible="false" wrapText="true" />
                        </VBox>
                    </HBox>

                    <!-- Row 2: Dates + Budget -->
                    <HBox spacing="18.0" alignment="TOP_LEFT">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label text="Travel Dates" styleClass="field-label" />
                                <Label fx:id="tripLengthLabel" text="" visible="false" managed="false"
                                       styleClass="badge, badge-teal" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <DatePicker fx:id="startDatePicker" promptText="Start date" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                <Label text="to" styleClass="meta-text" />
                                <DatePicker fx:id="endDatePicker" promptText="End date" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                            </HBox>
                            <Label text="Select between 1 and 7 days." styleClass="subtle-text" />
                            <Label fx:id="datesError" styleClass="field-error"
                                   managed="false" visible="false" wrapText="true" />
                        </VBox>

                        <VBox spacing="6.0" prefWidth="250.0" minWidth="210.0">
                            <Label text="Total Group Budget (USD)" styleClass="field-label" />
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="\$" styleClass="card-title" />
                                <TextField fx:id="budgetField" promptText="2400" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <Label text="Combined target for the whole trip." styleClass="subtle-text" />
                            <Label fx:id="budgetError" styleClass="field-error"
                                   managed="false" visible="false" wrapText="true" />
                        </VBox>
                    </HBox>

                    <Region styleClass="divider" />

                    <!-- Submit Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button fx:id="createTripBtn" text="Create Trip &amp; Start Quiz"
                                contentDisplay="RIGHT"
                                onAction="#handleCreateTrip" styleClass="btn-primary" />
                        <ProgressIndicator fx:id="createSpinner" prefWidth="22.0" prefHeight="22.0"
                                           visible="false" managed="false" />
                    </HBox>

                    <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="Infinity"
                           visible="false" managed="false" />
                </VBox>

                <!-- Earlier Trips List Card -->
                <VBox spacing="14.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Your Trips" styleClass="section-title" />
                            <Label fx:id="tripsMessageLabel" text="Loading your trips..."
                                   styleClass="meta-text" wrapText="true" />
                        </VBox>
                    </HBox>
                    <VBox fx:id="tripsList" spacing="10.0" />
                </VBox>

            </VBox>
        </StackPane>
    </content>
</ScrollPane>
