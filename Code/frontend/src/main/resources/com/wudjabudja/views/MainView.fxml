<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.MainController"
            prefWidth="1240.0"
            prefHeight="800.0"
            minWidth="980.0"
            minHeight="660.0"
            styleClass="app-canvas">

    <!-- Persistent Obsidian Left Sidebar (NAV-01) -->
    <left>
        <VBox prefWidth="256.0" minWidth="256.0" maxWidth="256.0"
              spacing="6.0" styleClass="sidebar">

            <!-- Brand Lockup -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox.margin><Insets bottom="8.0" /></VBox.margin>
                <StackPane fx:id="brandLogoBadge" styleClass="sidebar-brand-badge" />
                <VBox spacing="1.0">
                    <Label text="WudjaBudja" styleClass="sidebar-brand-title" />
                    <Label text="Group Travel Planner" styleClass="sidebar-brand-subtitle" />
                </VBox>
            </HBox>

            <Region styleClass="sidebar-divider">
                <VBox.margin><Insets top="4.0" bottom="8.0" /></VBox.margin>
            </Region>

            <!-- Active Trip Context Card -->
            <VBox fx:id="sidebarTripCard" spacing="3.0" styleClass="sidebar-trip-card">
                <VBox.margin><Insets bottom="6.0" /></VBox.margin>
                <Label fx:id="sidebarTripEyebrowLabel" text="ACTIVE TRIP" styleClass="sidebar-trip-eyebrow" />
                <Label fx:id="sidebarTripTitleLabel" text="No trip selected" styleClass="sidebar-trip-title" wrapText="true" />
                <Label fx:id="sidebarTripMetaLabel" text="Plan or open a trip to begin" styleClass="sidebar-trip-meta" wrapText="true" />
            </VBox>

            <!-- Workspace Navigation -->
            <Label text="WORKSPACE" styleClass="sidebar-section-label" />

            <Button fx:id="navTripSetupBtn" text="Plan a Trip"
                    maxWidth="Infinity" onAction="#showTripSetup" styleClass="nav-btn" />

            <Button fx:id="navDashboardBtn" text="Dashboard"
                    maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-btn" />

            <!-- Trip-Scoped Navigation -->
            <Label text="TRIP PLANNING" styleClass="sidebar-section-label">
                <VBox.margin><Insets top="6.0" /></VBox.margin>
            </Label>

            <Button fx:id="navTripsBtn" text="Shared Trip"
                    maxWidth="Infinity" onAction="#showTrips" styleClass="nav-btn" />

            <Button fx:id="navPreferencesBtn" text="Preferences Quiz"
                    maxWidth="Infinity" onAction="#showPreferences" styleClass="nav-btn" />

            <Button fx:id="navItineraryBtn" text="Itinerary"
                    maxWidth="Infinity" onAction="#showItinerary" styleClass="nav-btn" />

            <Button fx:id="navVotingBtn" text="Group Voting"
                    maxWidth="Infinity" onAction="#showVoting" styleClass="nav-btn" />

            <Button fx:id="navBriefingBtn" text="Trip Briefing"
                    maxWidth="Infinity" onAction="#showBriefing" styleClass="nav-btn" />

            <!-- Flexible Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <Region styleClass="sidebar-divider">
                <VBox.margin><Insets top="6.0" bottom="6.0" /></VBox.margin>
            </Region>

            <!-- User Profile Card -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sidebar-user-card">
                <StackPane styleClass="sidebar-avatar">
                    <Label fx:id="sidebarAvatarLabel" text="MB" styleClass="sidebar-avatar-text" />
                </StackPane>
                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserNameLabel" text="Miles Baack" styleClass="sidebar-user-name" />
                    <Label fx:id="sidebarUserEmailLabel" text="miles@example.com" styleClass="sidebar-user-email" />
                </VBox>
            </HBox>

            <!-- Logout Action -->
            <Button fx:id="logoutBtn" text="Sign Out"
                    maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-btn" />
        </VBox>
    </left>

    <!-- Dynamic Center StackPane -->
    <center>
        <StackPane fx:id="contentArea"
                   styleClass="app-canvas"
                   BorderPane.alignment="CENTER" />
    </center>

</BorderPane>
