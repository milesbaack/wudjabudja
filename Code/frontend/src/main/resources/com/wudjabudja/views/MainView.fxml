<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.MainController"
            prefWidth="1024.0"
            prefHeight="700.0"
            minWidth="800.0"
            minHeight="600.0">

    <!-- Static Left Sidebar (NAV-01) -->
    <left>
        <VBox prefWidth="230.0" minWidth="230.0" maxWidth="230.0"
              spacing="8.0"
              style="-fx-background-color: #0f172a;">
            <padding>
                <Insets top="24.0" right="14.0" bottom="20.0" left="14.0" />
            </padding>

            <!-- Brand Header -->
            <VBox spacing="2.0">
                <Label text="WudjaBudja" textFill="#f8fafc">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="AI Group Travel Planner" textFill="#64748b">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </VBox>

            <!-- Divider -->
            <Region prefHeight="1.0" style="-fx-background-color: #1e293b;">
                <VBox.margin>
                    <Insets top="8.0" bottom="8.0" />
                </VBox.margin>
            </Region>

            <!-- Navigation Links -->
            <Label text="MENU" textFill="#475569">
                <font>
                    <Font name="System Bold" size="10.0" />
                </font>
                <VBox.margin>
                    <Insets left="8.0" bottom="2.0" />
                </VBox.margin>
            </Label>

            <Button fx:id="navDashboardBtn" text="🏠  Dashboard"
                    maxWidth="Infinity"
                    onAction="#showDashboard" />

            <Button fx:id="navTripsBtn" text="✈️  My Trips"
                    maxWidth="Infinity"
                    onAction="#showTrips" />

            <Button fx:id="navPreferencesBtn" text="⚙️  Preferences"
                    maxWidth="Infinity"
                    onAction="#showPreferences" />

            <Button fx:id="navVotingBtn" text="🗳️  Group Voting"
                    maxWidth="Infinity"
                    onAction="#showVoting" />

            <Button fx:id="navBriefingBtn" text="📖  Trip Briefing"
                    maxWidth="Infinity"
                    onAction="#showBriefing" />

            <!-- Spacer pushes user profile and logout to the bottom -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- User Status Card -->
            <VBox spacing="3.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8;">
                <padding>
                    <Insets top="10.0" right="12.0" bottom="10.0" left="12.0" />
                </padding>
                <Label text="Miles Baack" textFill="#e2e8f0">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <Label text="miles@example.com" textFill="#94a3b8">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </VBox>

            <!-- Logout Button -->
            <Button fx:id="logoutBtn" text="🚪  Log Out"
                    maxWidth="Infinity"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-alignment: BASELINE_LEFT; -fx-padding: 8 12; -fx-cursor: hand;" />
        </VBox>
    </left>

    <!-- Dynamic Center StackPane for View Swapping (NAV-01) -->
    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #f8fafc;"
                   BorderPane.alignment="CENTER" />
    </center>

</BorderPane>
