<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wudjabudja.controllers.RegisterController"
      alignment="CENTER"
      spacing="14.0"
      prefWidth="420.0"
      prefHeight="580.0"
      style="-fx-background-color: #f8fafc;">

    <padding>
        <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
    </padding>

    <!-- App Branding -->
    <Label text="Create Account" textFill="#1e293b">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
    </Label>
    
    <Label text="Join WudjaBudja to start planning" textFill="#64748b">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox spacing="4.0" alignment="CENTER_LEFT" maxWidth="320.0">
        <Label text="Full Name" textFill="#334155" />
        <TextField fx:id="fullNameField" promptText="Miles Baack" prefHeight="38.0" />
    </VBox>

    <VBox spacing="4.0" alignment="CENTER_LEFT" maxWidth="320.0">
        <Label text="Email Address" textFill="#334155" />
        <TextField fx:id="emailField" promptText="you@example.com" prefHeight="38.0" />
    </VBox>

    <VBox spacing="4.0" alignment="CENTER_LEFT" maxWidth="320.0">
        <Label text="Password" textFill="#334155" />
        <PasswordField fx:id="passwordField" promptText="At least 6 characters" prefHeight="38.0" />
    </VBox>

    <VBox spacing="4.0" alignment="CENTER_LEFT" maxWidth="320.0">
        <Label text="Confirm Password" textFill="#334155" />
        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" prefHeight="38.0" />
    </VBox>

    <!-- Error message display area -->
    <Label fx:id="errorLabel" text="" textFill="#dc2626" wrapText="true" maxWidth="320.0">
        <font>
            <Font size="13.0" />
        </font>
    </Label>

    <!-- Action Buttons -->
    <Button fx:id="registerButton" text="Create Account" onAction="#handleRegister"
            prefWidth="320.0" prefHeight="40.0"
            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

    <Hyperlink text="Already have an account? Log in" onAction="#goToLogin" textFill="#2563eb" />

</VBox>
