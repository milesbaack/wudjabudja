<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.PreferenceController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER" styleClass="app-canvas">
            <VBox spacing="20.0" maxWidth="920.0" styleClass="page-container">

                <!-- Quiz Header, Stepper & Traveler Switcher -->
                <VBox spacing="14.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="PREFERENCES QUIZ" styleClass="badge, badge-teal" />
                        <Label fx:id="tripLabel" text="" styleClass="meta-text" wrapText="true" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="stepCounterLabel" text="Step 1 of 6" styleClass="badge, badge-dark" />
                    </HBox>

                    <!-- Clickable 6-Step Visual Stepper -->
                    <FlowPane hgap="8.0" vgap="8.0">
                        <Button fx:id="stepperBtn1" text="1. Schedule" onAction="#jumpToStep1" styleClass="stepper-pill-active" />
                        <Button fx:id="stepperBtn2" text="2. Radius" onAction="#jumpToStep2" styleClass="stepper-pill" />
                        <Button fx:id="stepperBtn3" text="3. Comfort" onAction="#jumpToStep3" styleClass="stepper-pill" />
                        <Button fx:id="stepperBtn4" text="4. Budget" onAction="#jumpToStep4" styleClass="stepper-pill" />
                        <Button fx:id="stepperBtn5" text="5. Interests" onAction="#jumpToStep5" styleClass="stepper-pill" />
                        <Button fx:id="stepperBtn6" text="6. Review" onAction="#jumpToStep6" styleClass="stepper-pill" />
                    </FlowPane>

                    <ProgressBar fx:id="quizProgressBar" progress="0.16" maxWidth="Infinity" />

                    <VBox spacing="3.0">
                        <Label fx:id="stepHeadingLabel" text="Step 1: Daily Schedule &amp; Wake-Up Time" styleClass="page-title" />
                        <Label text="Configure your schedule, exploration range, budget breakdown, and activity interests."
                               styleClass="body-text" wrapText="true" />
                    </VBox>

                    <!-- Traveler Switcher for Shared Trips -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="well">
                        <Label text="Answering for:" styleClass="field-label" />
                        <ComboBox fx:id="travelerCombo" onAction="#handleTravelerSelected"
                                  prefWidth="380.0" promptText="Select traveler on trip..." styleClass="combo-sm" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Manage Travelers" onAction="#goToSharedTrip" styleClass="btn-secondary, btn-sm" />
                    </HBox>
                </VBox>

                <!-- Dynamic Question Content Area -->
                <StackPane fx:id="stepContainer">

                    <!-- STEP 1: Morning Routine & Wake-Up Time -->
                    <VBox fx:id="step1Pane" spacing="18.0" styleClass="card">
                        <VBox spacing="4.0">
                            <Label text="When does your typical vacation day start?" styleClass="section-title" />
                            <Label text="Morning activities will never be scheduled earlier than one hour after your wake-up time."
                                   styleClass="body-text" wrapText="true" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Quick Presets" styleClass="field-label" />
                            <HBox spacing="12.0">
                                <Button fx:id="presetEarlyBtn" text="Early Bird · 7:00 AM" onAction="#setPresetEarly"
                                        styleClass="preset-btn" />
                                <Button fx:id="presetStandardBtn" text="Standard · 8:30 AM" onAction="#setPresetStandard"
                                        styleClass="preset-btn-active" />
                                <Button fx:id="presetLateBtn" text="Sleep In · 10:00 AM" onAction="#setPresetLate"
                                        styleClass="preset-btn" />
                            </HBox>
                        </VBox>

                        <Region styleClass="divider" />

                        <VBox spacing="6.0">
                            <Label text="Exact Wake-Up Time" styleClass="field-label" />
                            <ComboBox fx:id="wakeTimeCombo" prefWidth="240.0" promptText="Select wake time..." />
                        </VBox>
                    </VBox>

                    <!-- STEP 2: Exploration Radius -->
                    <VBox fx:id="step2Pane" visible="false" managed="false" spacing="18.0" styleClass="card">
                        <VBox spacing="4.0">
                            <Label text="How far are you willing to travel from your base hotel?" styleClass="section-title" />
                            <Label text="Sets the maximum travel radius for candidate activities and day excursions."
                                   styleClass="body-text" wrapText="true" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0" styleClass="well">
                            <padding><Insets top="22.0" right="20.0" bottom="22.0" left="20.0" /></padding>
                            <Label fx:id="radiusValueLabel" text="15 miles" styleClass="stat-value-lg" />
                            <Label fx:id="radiusHintLabel" text="City-Wide &amp; Metro Transit Explorer" styleClass="body-text" />
                        </VBox>

                        <Slider fx:id="radiusSlider" min="1.0" max="50.0" value="15.0"
                                blockIncrement="1.0" majorTickUnit="10.0" showTickMarks="true" prefHeight="30.0" />

                        <HBox>
                            <Label text="1 mile (Walkable)" styleClass="subtle-text" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="25 miles (Metro Area)" styleClass="subtle-text" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="50 miles (Regional)" styleClass="subtle-text" />
                        </HBox>
                    </VBox>

                    <!-- STEP 3: Travel Experience Level -->
                    <VBox fx:id="step3Pane" visible="false" managed="false" spacing="18.0" styleClass="card">
                        <VBox spacing="4.0">
                            <Label text="What is your travel comfort level in unfamiliar cities?" styleClass="section-title" />
                            <Label text="Calibrates transit complexity, language barriers, and activity independence."
                                   styleClass="body-text" wrapText="true" />
                        </VBox>

                        <fx:define>
                            <ToggleGroup fx:id="experienceGroup" />
                        </fx:define>

                        <!-- Entirely Clickable Option Cards -->
                        <VBox spacing="12.0">
                            <VBox fx:id="noviceCard" spacing="5.0" styleClass="choice-card">
                                <RadioButton fx:id="noviceRadio" text="Novice Traveler" toggleGroup="$experienceGroup" styleClass="item-title" />
                                <Label text="Prefer easy-to-reach landmarks, guided walking tours, English-friendly menus, and simple transit."
                                       styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="intermediateCard" spacing="5.0" styleClass="choice-card-selected">
                                <RadioButton fx:id="intermediateRadio" text="Intermediate Explorer (Recommended)" toggleGroup="$experienceGroup"
                                             selected="true" styleClass="item-title" />
                                <Label text="Comfortable with subway transfers, exploring vibrant local neighborhoods, self-guided maps, and cultural food."
                                       styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="expertCard" spacing="5.0" styleClass="choice-card">
                                <RadioButton fx:id="expertRadio" text="Expert Adventurer" toggleGroup="$experienceGroup" styleClass="item-title" />
                                <Label text="Confident venturing off the beaten path, taking regional trains, navigating language barriers, and finding hidden local spots."
                                       styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- STEP 4: Budget Allocation -->
                    <VBox fx:id="step4Pane" visible="false" managed="false" spacing="18.0" styleClass="card">
                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label text="How would you like to allocate your spending?" styleClass="section-title" />
                                <Label text="Set per-person estimates across key categories." styleClass="body-text" />
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="2.0"
                                  style="-fx-background-color: #ECFDF5; -fx-border-color: #A7F3D0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 16;">
                                <Label fx:id="totalBudgetLabel" text="\$710 Total"
                                       style="-fx-text-fill: #065F46; -fx-font-weight: bold; -fx-font-size: 17px;" />
                                <Label fx:id="totalBreakdownLabel" text="Estimated per person"
                                       style="-fx-text-fill: #047857; -fx-font-size: 11px;" />
                            </VBox>
                        </HBox>

                        <VBox spacing="5.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Transit &amp; Transportation (Subways, passes, taxis)" styleClass="field-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="transitValueLabel" text="\$60" styleClass="item-title" />
                            </HBox>
                            <Slider fx:id="transitSlider" min="0.0" max="300.0" value="60.0" blockIncrement="10.0" majorTickUnit="50.0" />
                        </VBox>

                        <VBox spacing="5.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Lodging &amp; Accommodations Share" styleClass="field-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lodgingValueLabel" text="\$300" styleClass="item-title" />
                            </HBox>
                            <Slider fx:id="lodgingSlider" min="0.0" max="1000.0" value="300.0" blockIncrement="25.0" majorTickUnit="200.0" />
                        </VBox>

                        <VBox spacing="5.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Food &amp; Dining (Restaurants, local spots, cafes)" styleClass="field-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="foodValueLabel" text="\$200" styleClass="item-title" />
                            </HBox>
                            <Slider fx:id="foodSlider" min="0.0" max="800.0" value="200.0" blockIncrement="20.0" majorTickUnit="150.0" />
                        </VBox>

                        <VBox spacing="5.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Activities, Museum Tickets &amp; Experiences" styleClass="field-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="activitiesValueLabel" text="\$150" styleClass="item-title" />
                            </HBox>
                            <Slider fx:id="activitiesSlider" min="0.0" max="600.0" value="150.0" blockIncrement="15.0" majorTickUnit="100.0" />
                        </VBox>

                        <Region styleClass="divider" />

                        <VBox spacing="5.0" styleClass="well-plain">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Single-Activity Price Cap (Per Person)" styleClass="item-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="perBlockCapLabel" text="\$35 / activity" styleClass="badge, badge-teal" />
                            </HBox>
                            <Label text="Avoid recommending any single ticketed activity exceeding this cap." styleClass="meta-text" />
                            <Slider fx:id="perBlockCapSlider" min="10.0" max="150.0" value="35.0" blockIncrement="5.0" majorTickUnit="25.0" />
                        </VBox>
                    </VBox>

                    <!-- STEP 5: Interests & Activity Vibes -->
                    <VBox fx:id="step5Pane" visible="false" managed="false" spacing="18.0" styleClass="card">
                        <VBox spacing="4.0">
                            <Label text="What experiences get you most excited?" styleClass="section-title" />
                            <Label text="Click any card to select categories matching your travel style (select at least one)."
                                   styleClass="body-text" wrapText="true" />
                        </VBox>

                        <GridPane hgap="14.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                            </columnConstraints>

                            <VBox fx:id="foodCard" GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="4.0" styleClass="choice-card-selected">
                                <CheckBox fx:id="interestFood" text="Food &amp; Dining" selected="true" styleClass="item-title" />
                                <Label text="Local markets, restaurants, specialty foods" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="cultureCard" GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="4.0" styleClass="choice-card-selected">
                                <CheckBox fx:id="interestCulture" text="Culture &amp; History" selected="true" styleClass="item-title" />
                                <Label text="Historic districts, landmarks, museums" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="outdoorsCard" GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="4.0" styleClass="choice-card">
                                <CheckBox fx:id="interestOutdoors" text="Nature &amp; Hikes" styleClass="item-title" />
                                <Label text="Botanical gardens, trails, scenic parks" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="nightlifeCard" GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="4.0" styleClass="choice-card-selected">
                                <CheckBox fx:id="interestNightlife" text="Nightlife &amp; Bars" selected="true" styleClass="item-title" />
                                <Label text="Bars, live music, late-night spots, lounges" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="shoppingCard" GridPane.columnIndex="0" GridPane.rowIndex="2" spacing="4.0" styleClass="choice-card">
                                <CheckBox fx:id="interestShopping" text="Shopping &amp; Markets" styleClass="item-title" />
                                <Label text="Flea markets, local crafts, boutiques" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="relaxationCard" GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="4.0" styleClass="choice-card">
                                <CheckBox fx:id="interestRelaxation" text="Spas &amp; Relaxation" styleClass="item-title" />
                                <Label text="Spas, bathhouses, quiet parks, cafes" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="sportsCard" GridPane.columnIndex="0" GridPane.rowIndex="3" spacing="4.0" styleClass="choice-card-selected">
                                <CheckBox fx:id="interestSports" text="Sports &amp; Live Games" selected="true" styleClass="item-title" />
                                <Label text="Live games, stadium events, active outings" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>

                            <VBox fx:id="tourCard" GridPane.columnIndex="1" GridPane.rowIndex="3" spacing="4.0" styleClass="choice-card">
                                <CheckBox fx:id="interestTour" text="Guided Tours" styleClass="item-title" />
                                <Label text="Curated walks, culinary tours, local guides" styleClass="meta-text" wrapText="true">
                                    <padding><Insets left="26.0" /></padding>
                                </Label>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- STEP 6: Review & Finalize -->
                    <VBox fx:id="step6Pane" visible="false" managed="false" spacing="18.0" styleClass="card">
                        <VBox spacing="4.0">
                            <Label text="Review Your Travel Profile" styleClass="section-title" />
                            <Label text="Double-check your answers below before syncing with the group trip."
                                   styleClass="body-text" wrapText="true" />
                        </VBox>

                        <VBox spacing="11.0" styleClass="well">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Wake-Up Time" styleClass="meta-text" prefWidth="180.0" />
                                <Label fx:id="summaryWakeTime" text="08:30 AM" styleClass="item-title" />
                            </HBox>
                            <Region styleClass="divider" />
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Exploration Radius" styleClass="meta-text" prefWidth="180.0" />
                                <Label fx:id="summaryRadius" text="15 miles" styleClass="item-title" />
                            </HBox>
                            <Region styleClass="divider" />
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Experience Level" styleClass="meta-text" prefWidth="180.0" />
                                <Label fx:id="summaryExperience" text="Intermediate Explorer" styleClass="item-title" />
                            </HBox>
                            <Region styleClass="divider" />
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Total Budget" styleClass="meta-text" prefWidth="180.0" />
                                <Label fx:id="summaryTotalBudget" text="\$710 estimated per person"
                                       style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 14px;" />
                            </HBox>
                            <Region styleClass="divider" />
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Max Activity Cap" styleClass="meta-text" prefWidth="180.0" />
                                <Label fx:id="summaryPerBlockCap" text="\$35 / activity" styleClass="item-title" />
                            </HBox>
                            <Region styleClass="divider" />
                            <HBox alignment="TOP_LEFT">
                                <Label text="Top Interests" styleClass="meta-text" prefWidth="180.0" />
                                <Label fx:id="summaryInterests" text="Food, Culture, Nightlife, Sports"
                                       style="-fx-text-fill: #0F766E; -fx-font-weight: bold; -fx-font-size: 13.5px;"
                                       wrapText="true" maxWidth="500.0" />
                            </HBox>
                        </VBox>

                        <FlowPane hgap="10.0" vgap="10.0" alignment="CENTER_LEFT">
                            <Button fx:id="saveAndContinueBtn" text="Save &amp; Continue to Shared Trip"
                                    onAction="#handleSaveAndContinue" styleClass="btn-primary" />
                            <Button fx:id="savePreferencesBtn" text="Save Preferences"
                                    onAction="#handleSavePreferences" styleClass="btn-accent" />
                            <Button fx:id="loadPreferencesBtn" text="Load from Server"
                                    onAction="#handleLoadPreferences" styleClass="btn-secondary" />
                            <Button fx:id="resetDefaultsBtn" text="Reset Defaults"
                                    onAction="#handleReset" styleClass="btn-ghost" />
                        </FlowPane>
                    </VBox>

                </StackPane>

                <!-- Bottom Step Navigation Bar & Feedback -->
                <VBox spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button fx:id="prevBtn" text="Back" onAction="#handlePrevStep" visible="false"
                                styleClass="btn-secondary" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="nextBtn" text="Next Question" contentDisplay="RIGHT"
                                onAction="#handleNextStep" styleClass="btn-primary" />
                    </HBox>

                    <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="Infinity"
                           visible="false" managed="false" />
                </VBox>

            </VBox>
        </StackPane>
    </content>
</ScrollPane>
