<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Shared Trip Screen (GRP-03): Roster management, traveler quiz switching, and group options display. -->
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.TripsController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER" styleClass="app-canvas">
            <VBox spacing="22.0" maxWidth="1140.0" styleClass="page-container">

                <!-- 1. Trip Header Card -->
                <VBox spacing="14.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="SHARED TRIP" styleClass="badge, badge-teal" />
                        <Label fx:id="joinCodeBadge" text="" styleClass="badge, badge-neutral, mono-text" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Switch / New Trip" onAction="#goToTripSetup" styleClass="btn-secondary, btn-sm" />
                    </HBox>

                    <VBox spacing="4.0">
                        <Label fx:id="tripTitleLabel" text="Shared Group Trip" styleClass="page-title" wrapText="true" />
                        <Label fx:id="tripDetailsLabel" text="" styleClass="body-text" wrapText="true" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button fx:id="generateBtn" text="Generate Group Options" onAction="#handleGenerateOptions"
                                styleClass="btn-primary" />
                        <Button text="Go to Group Voting" onAction="#goToVoting" styleClass="btn-accent" />
                        <Button text="Full Itinerary View" onAction="#goToItinerary" styleClass="btn-secondary" />
                    </HBox>

                    <HBox fx:id="busyBox" alignment="CENTER_LEFT" spacing="12.0"
                          visible="false" managed="false" styleClass="banner-busy">
                        <ProgressIndicator prefWidth="20.0" prefHeight="20.0" />
                        <Label fx:id="busyLabel" text="" styleClass="banner-busy-text" wrapText="true" />
                    </HBox>

                    <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="Infinity"
                           visible="false" managed="false" />
                </VBox>

                <!-- 2. Group Travelers Roster + Add Traveler Form -->
                <VBox spacing="16.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label text="Travelers on This Trip" styleClass="section-title" />
                            <Label fx:id="travelersSummaryLabel"
                                   text="Add travelers by email below, then click &quot;Take / Edit Quiz&quot; next to any traveler to enter their preferences."
                                   styleClass="meta-text" wrapText="true" />
                        </VBox>
                        <Button fx:id="refreshBtn" text="Refresh" onAction="#handleRefresh"
                                styleClass="btn-secondary, btn-sm" />
                    </HBox>

                    <!-- Add Traveler Bar -->
                    <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="well">
                        <Label text="Invite traveler" styleClass="field-label" />
                        <TextField fx:id="travelerEmailField"
                                   promptText="Traveler email (e.g. alex@example.com)"
                                   onAction="#handleAddTraveler"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="addTravelerBtn" text="Add Traveler" onAction="#handleAddTraveler"
                                styleClass="btn-primary" />
                        <ProgressIndicator fx:id="addTravelerSpinner" prefWidth="20.0" prefHeight="20.0"
                                           visible="false" managed="false" />
                    </HBox>

                    <Label fx:id="travelerStatusLabel" text="" wrapText="true" maxWidth="Infinity"
                           visible="false" managed="false" />

                    <!-- Dynamic Participants Roster -->
                    <VBox fx:id="participantsListBox" spacing="10.0" />
                </VBox>

                <!-- 3. Group Activity Options Section -->
                <VBox spacing="14.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Group Activity Options" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="generatedAtLabel" text="" styleClass="meta-text" />
                    </HBox>

                    <VBox fx:id="emptyOptionsBox" spacing="10.0" alignment="CENTER"
                          visible="false" managed="false" styleClass="empty-state">
                        <Label text="No group options generated yet" styleClass="section-title" />
                        <Label text="Once your travelers have saved their quiz preferences above, click &quot;Generate Group Options&quot; to plan activities for everyone (including subgroup splits when interests conflict)."
                               styleClass="body-text" wrapText="true" maxWidth="560.0"
                               style="-fx-text-alignment: center;" />
                    </VBox>

                    <VBox fx:id="daysBox" spacing="18.0" />
                </VBox>

            </VBox>
        </StackPane>
    </content>
</ScrollPane>
