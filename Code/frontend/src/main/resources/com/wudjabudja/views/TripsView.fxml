<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            style="-fx-background: #f8fafc; -fx-background-color: transparent;">

    <content>
        <VBox spacing="24.0" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets top="28.0" right="36.0" bottom="36.0" left="36.0" />
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4.0">
                    <Label text="My Trips" textFill="#0f172a">
                        <font><Font name="System Bold" size="24.0" /></font>
                    </Label>
                    <Label text="View your upcoming trips or join a friend's group adventure." textFill="#64748b">
                        <font><Font size="14.0" /></font>
                    </Label>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <Button text="Join with Code"
                            style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;" />
                    <Button text="+ Create Trip"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-padding: 8 16; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                </HBox>
            </HBox>

            <!-- Trip Card -->
            <VBox spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Active Trip" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-padding: 2 8; -fx-background-radius: 12;">
                        <font><Font size="11.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Code: WUDJA-TOKYO" style="-fx-font-family: monospace;" textFill="#64748b" />
                </HBox>
                <Label text="🇯🇵 Tokyo &amp; Kyoto Autumn Explorer" textFill="#0f172a">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>
                <Label text="Nov 14 – Nov 22, 2026 • 4 Travelers • Tokyo, Japan" textFill="#64748b">
                    <font><Font size="13.0" /></font>
                </Label>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
