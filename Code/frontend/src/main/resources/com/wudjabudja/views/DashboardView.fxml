<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="24.0"
      style="-fx-background-color: #f8fafc;">
    <padding>
        <Insets top="32.0" right="36.0" bottom="32.0" left="36.0" />
    </padding>

    <!-- Welcome Header -->
    <VBox spacing="4.0">
        <Label text="Welcome to WudjaBudja" textFill="#0f172a">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>
        <Label text="Collaborative AI-powered travel planning for groups" textFill="#64748b">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
    </VBox>

    <!-- Overview / Quick Actions Cards -->
    <HBox spacing="16.0">
        <!-- Active Trip Card -->
        <VBox prefWidth="340.0" spacing="12.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="✈️ Current Trip" textFill="#0f172a">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Sprint 3" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-padding: 2 8; -fx-background-radius: 12;">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </HBox>
            <Label text="Tokyo Adventure 2026" textFill="#1e293b">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label text="Dates: Nov 12 - Nov 19, 2026\nBudget: $2,500 / person\nGroup: 4 Travelers"
                   textFill="#475569" wrapText="true">
                <font>
                    <Font size="13.0" />
                </font>
            </Label>
        </VBox>

        <!-- Preference Status Card -->
        <VBox prefWidth="340.0" spacing="12.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="⚙️ Preferences" textFill="#0f172a">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Pending" style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-padding: 2 8; -fx-background-radius: 12;">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </HBox>
            <Label text="Granular Intake (PREF-02)" textFill="#1e293b">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label text="Specify wake-up time, travel radius, and budget categories so the AI can craft conflict-free days."
                   textFill="#475569" wrapText="true">
                <font>
                    <Font size="13.0" />
                </font>
            </Label>
        </VBox>
    </HBox>

    <!-- Information Banner -->
    <VBox spacing="8.0"
          style="-fx-background-color: #eff6ff; -fx-background-radius: 8; -fx-border-color: #bfdbfe; -fx-border-radius: 8;">
        <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
        </padding>
        <Label text="💡 How It Works" textFill="#1e40af">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label text="1. Set your individual travel constraints in Preferences.\n2. When all participants are ready, Gemini generates ranked options.\n3. Vote on activities using Borda count to produce your group's 'Perfect Days'."
               textFill="#1e3a8a" wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
    </VBox>

</VBox>
