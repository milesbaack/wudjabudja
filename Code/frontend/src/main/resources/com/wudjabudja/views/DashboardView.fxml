<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wudjabudja.controllers.DashboardController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER" styleClass="app-canvas">
            <VBox spacing="22.0" maxWidth="1140.0" styleClass="page-container">

                <!-- Top Greeting Header -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="greetingLabel" text="Welcome back" styleClass="page-title" />
                        <Label text="Live overview of your group trip, traveler readiness, and consensus itinerary."
                               styleClass="body-text" wrapText="true" />
                    </VBox>
                    <Button fx:id="refreshBtn" text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary" />
                    <Button fx:id="newTripBtn" text="Plan New Trip" onAction="#goToTripSetup" styleClass="btn-primary" />
                </HBox>

                <!-- Loading Bar -->
                <HBox fx:id="busyBox" alignment="CENTER_LEFT" spacing="10.0"
                      visible="false" managed="false" styleClass="banner-busy">
                    <ProgressIndicator prefWidth="18.0" prefHeight="18.0" />
                    <Label fx:id="busyLabel" text="Loading live trip dashboard..." styleClass="banner-busy-text" />
                </HBox>

                <!-- Empty State (no trip created yet) -->
                <VBox fx:id="noTripBox" alignment="CENTER" spacing="12.0"
                      visible="false" managed="false" styleClass="empty-state">
                    <Label text="No active trip yet" styleClass="section-title" />
                    <Label text="Create your first trip in &quot;Plan a Trip&quot; to see live group readiness, quiz profiles, voting winners, and destination briefings here."
                           styleClass="body-text" wrapText="true" maxWidth="540.0"
                           style="-fx-text-alignment: center;" />
                    <Button text="Plan Your First Trip" onAction="#goToTripSetup" styleClass="btn-primary" />
                </VBox>

                <!-- Main Live Dashboard Content -->
                <VBox fx:id="activeTripContentBox" spacing="22.0">

                    <!-- Signature Dark Obsidian-Teal Active Trip Hero Banner -->
                    <VBox spacing="18.0" styleClass="hero-card">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="ACTIVE TRIP" styleClass="badge, badge-hero-teal" />
                            <Label fx:id="joinCodeLabel" text="Join Code: —"
                                   styleClass="badge, badge-hero-glass, mono-text" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="countdownLabel" text=""
                                   style="-fx-text-fill: #5EEAD4; -fx-font-weight: bold; -fx-font-size: 12.5px;" />
                        </HBox>

                        <VBox spacing="5.0">
                            <Label fx:id="tripTitleLabel" text="Loading trip..."
                                   styleClass="hero-title" wrapText="true" />
                            <Label fx:id="tripSubtitleLabel" text=""
                                   styleClass="hero-subtitle" wrapText="true" />
                        </VBox>

                        <!-- Frosted Glass KPI Strip -->
                        <HBox spacing="20.0" alignment="CENTER_LEFT" styleClass="hero-stat-strip">
                            <VBox spacing="3.0">
                                <Label text="Total Trip Budget" styleClass="hero-stat-label" />
                                <Label fx:id="statBudgetLabel" text="—" styleClass="hero-stat-value" />
                            </VBox>
                            <Region styleClass="hero-divider" />
                            <VBox spacing="3.0">
                                <Label text="Trip Type" styleClass="hero-stat-label" />
                                <Label fx:id="statTripTypeLabel" text="—" styleClass="hero-stat-value" />
                            </VBox>
                            <Region styleClass="hero-divider" />
                            <VBox spacing="3.0">
                                <Label text="Itinerary &amp; Consensus" styleClass="hero-stat-label" />
                                <Label fx:id="statItineraryStatusLabel" text="—" styleClass="hero-stat-value" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Manage Travelers" onAction="#goToTrips" styleClass="btn-hero-glass" />
                        </HBox>

                        <!-- Group Readiness Progress -->
                        <VBox spacing="8.0">
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <Label text="Group Intake:" style="-fx-text-fill: #E2E8F0; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label fx:id="readinessTextLabel" text="Checking traveler quizzes..."
                                       style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="readinessPercentLabel" text="0% Ready"
                                       style="-fx-text-fill: #5EEAD4; -fx-font-weight: bold; -fx-font-size: 12px;" />
                            </HBox>
                            <ProgressBar fx:id="readinessProgressBar" progress="0.0"
                                         maxWidth="Infinity" styleClass="hero-progress-bar" />
                        </VBox>
                    </VBox>

                    <!-- Two-Column Row: Travel Profile & Voting Highlights -->
                    <HBox spacing="20.0">

                        <!-- Left Card: Active Traveler Profile -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14.0" prefWidth="420.0" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label fx:id="profileCardTitleLabel" text="Your Travel Profile" styleClass="card-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="profileStatusBadge" text="Checking..." styleClass="badge, badge-warning" />
                            </HBox>

                            <Label text="Personal schedule, exploration radius, and activity priorities saved for this trip."
                                   styleClass="meta-text" wrapText="true" />

                            <VBox spacing="9.0" styleClass="well-plain">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Wake-up Time" styleClass="meta-text" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="prefWakeTimeLabel" text="—" styleClass="field-label" />
                                </HBox>
                                <Region styleClass="divider" />
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Experience Level" styleClass="meta-text" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="prefExperienceLabel" text="—" styleClass="field-label" />
                                </HBox>
                                <Region styleClass="divider" />
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Max Radius" styleClass="meta-text" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="prefRadiusLabel" text="—" styleClass="field-label" />
                                </HBox>
                                <Region styleClass="divider" />
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Per-Activity Cap" styleClass="meta-text" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="prefCapLabel" text="—" styleClass="field-label" />
                                </HBox>
                                <Region styleClass="divider" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Interests" styleClass="meta-text" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="prefInterestsLabel" text="—" styleClass="field-label" wrapText="true" />
                                </HBox>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" />
                            <Button text="Update Preferences Quiz" onAction="#goToPreferences"
                                    maxWidth="Infinity" styleClass="btn-primary" />
                        </VBox>

                        <!-- Right Card: Itinerary & Voting Highlights -->
                        <VBox HBox.hgrow="ALWAYS" spacing="14.0" prefWidth="420.0" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="Group Voting &amp; Winners" styleClass="card-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="votingStatusBadge" text="Next Up" styleClass="badge, badge-teal" />
                            </HBox>

                            <Label fx:id="votingSubtitleLabel"
                                   text="Rank your 1st, 2nd, and 3rd choices for each time block to elect the group's consensus activities."
                                   styleClass="meta-text" wrapText="true" />

                            <VBox fx:id="votingPreviewBox" spacing="9.0" />

                            <Region VBox.vgrow="ALWAYS" />
                            <HBox spacing="10.0">
                                <Button text="View Itinerary" onAction="#goToItinerary"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary" />
                                <Button text="Open Group Voting" onAction="#goToVoting"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Bottom Pre-Departure Briefing Callout -->
                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="banner-briefing-callout">
                        <StackPane fx:id="briefingIconBox" />
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="briefingHighlightTitle" text="Pre-Trip Destination Briefing" styleClass="item-title" />
                            <Label fx:id="briefingHighlightText"
                                   text="Generate a custom Trip Briefing for local etiquette, language phrases, packing lists, and souvenir ideas."
                                   styleClass="body-text" wrapText="true" />
                        </VBox>
                        <Button text="Open Briefing" onAction="#goToBriefing" styleClass="btn-secondary" />
                    </HBox>

                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
