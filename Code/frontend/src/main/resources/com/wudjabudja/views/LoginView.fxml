<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wudjabudja.controllers.LoginController"
      alignment="CENTER"
      spacing="16.0"
      prefWidth="420.0"
      prefHeight="520.0"
      style="-fx-background-color: #f8fafc;">

    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
    </padding>

    <!-- App Branding -->
    <Label text="WudjaBudja" textFill="#1e293b">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>
    
    <Label text="Plan group trips without the headache" textFill="#64748b">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox spacing="6.0" alignment="CENTER_LEFT" maxWidth="320.0">
        <Label text="Email Address" textFill="#334155" />
        <TextField fx:id="emailField" promptText="you@example.com" prefHeight="38.0" />
    </VBox>

    <VBox spacing="6.0" alignment="CENTER_LEFT" maxWidth="320.0">
        <Label text="Password" textFill="#334155" />
        <PasswordField fx:id="passwordField" promptText="Enter your password" prefHeight="38.0" />
    </VBox>

    <!-- Error message display area (hidden/empty until an error occurs) -->
    <Label fx:id="errorLabel" text="" textFill="#dc2626" wrapText="true" maxWidth="320.0">
        <font>
            <Font size="13.0" />
        </font>
    </Label>

    <!-- Action Buttons -->
    <Button fx:id="loginButton" text="Log In" onAction="#handleLogin"
            prefWidth="320.0" prefHeight="40.0"
            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

    <Hyperlink text="Don't have an account? Sign up" onAction="#goToRegister" textFill="#2563eb" />

</VBox>
