<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wudjabudja.controllers.LoginController"
      prefWidth="960.0"
      prefHeight="640.0"
      styleClass="app-canvas">

    <!-- Left Atmospheric Brand Panel -->
    <VBox prefWidth="420.0" minWidth="360.0" spacing="22.0" styleClass="auth-brand-pane">
        <!-- Brand Lockup -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <StackPane fx:id="brandLogoBadge" styleClass="sidebar-brand-badge" />
            <VBox spacing="1.0">
                <Label text="WudjaBudja" styleClass="sidebar-brand-title" />
                <Label text="AI Group Travel Concierge" styleClass="sidebar-brand-subtitle" />
            </VBox>
        </HBox>

        <Region prefHeight="8.0" />

        <VBox spacing="10.0">
            <Label text="Group trips, planned without the chaos."
                   styleClass="hero-title" wrapText="true" minHeight="-Infinity" />
            <Label text="Balance everyone's wake times, budgets, and travel vibes automatically — then elect your perfect days together."
                   styleClass="hero-subtitle" wrapText="true" minHeight="-Infinity" />
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Value Pillars -->
        <VBox spacing="10.0">
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="auth-feature-row">
                <StackPane fx:id="featureIcon1" />
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="6-Step Preference Quiz" styleClass="auth-feature-title" />
                    <Label text="Capture each traveler's schedule, radius, and budget caps." styleClass="auth-feature-desc" wrapText="true" minHeight="-Infinity" />
                </VBox>
            </HBox>
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="auth-feature-row">
                <StackPane fx:id="featureIcon2" />
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="AI Group &amp; Subgroup Options" styleClass="auth-feature-title" />
                    <Label text="3 curated activities per time block with smart group splits." styleClass="auth-feature-desc" wrapText="true" minHeight="-Infinity" />
                </VBox>
            </HBox>
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="auth-feature-row">
                <StackPane fx:id="featureIcon3" />
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Borda Count Consensus" styleClass="auth-feature-title" />
                    <Label text="Fair ranked-choice voting with lowest-cost tie-breaking." styleClass="auth-feature-desc" wrapText="true" minHeight="-Infinity" />
                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <!-- Right Clean Form Canvas -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-form-pane">
        <VBox spacing="18.0" maxWidth="410.0" maxHeight="-Infinity" styleClass="auth-card">
            <VBox spacing="5.0">
                <Label text="WELCOME BACK" styleClass="badge, badge-teal" />
                <Label text="Sign in to WudjaBudja" styleClass="page-title">
                    <VBox.margin><Insets top="4.0" /></VBox.margin>
                </Label>
                <Label text="Enter your credentials to access your group trips and itineraries."
                       styleClass="body-text" wrapText="true" />
            </VBox>

            <VBox spacing="14.0">
                <VBox spacing="6.0">
                    <Label text="Email Address" styleClass="field-label" />
                    <TextField fx:id="emailField" promptText="you@example.com" onAction="#handleLogin" />
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Password" styleClass="field-label" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password" onAction="#handleLogin" />
                </VBox>
            </VBox>

            <!-- Inline Error Banner -->
            <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false" />

            <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="btn-primary" />

            <Region styleClass="divider" />

            <HBox alignment="CENTER" spacing="4.0">
                <Label text="New to WudjaBudja?" styleClass="meta-text" />
                <Hyperlink text="Create an account" onAction="#goToRegister" styleClass="auth-link" />
            </HBox>
        </VBox>
    </StackPane>

</HBox>
