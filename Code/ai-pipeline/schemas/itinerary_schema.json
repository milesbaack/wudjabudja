{
  "type": "object",
  "properties": {
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "blocks": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "block": { "type": "string", "enum": ["morning", "afternoon", "evening"] },
                "subgroups": {
                  "type": "array", "minItems": 1, "maxItems": 2,
                  "items": {
                    "type": "object",
                    "properties": {
                      "participant_ids": { "type": "array", "items": { "type": "string" } },
                      "split_reason": { "type": ["string", "null"] },
                      "options": {
                        "type": "array", "minItems": 3, "maxItems": 3,
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": { "type": "string" },
                            "description": { "type": "string" },
                            "category": { "type": "string", "enum": ["food", "outdoors", "culture", "nightlife", "sports", "shopping", "relaxation", "tour"] },
                            "neighborhood": { "type": "string" },
                            "start_time": { "type": "string", "description": "24-hour HH:MM" },
                            "end_time": { "type": "string", "description": "24-hour HH:MM" },
                            "estimated_cost_usd": { "type": "number", "minimum": 0 },
                            "why_it_fits": { "type": "string" }
                          },
                          "required": ["title", "description", "category", "neighborhood", "start_time", "end_time", "estimated_cost_usd", "why_it_fits"]
                        }
                      }
                    },
                    "required": ["participant_ids", "split_reason", "options"]
                  }
                }
              },
              "required": ["block", "subgroups"]
            }
          }
        },
        "required": ["date", "blocks"]
      }
    }
  },
  "required": ["days"]
}
